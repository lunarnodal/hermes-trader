# ─── Hermes Trader — Environment Configuration ───────────────────────────────
# Copy this file to pipeline/.env and fill in your values.
# Never commit pipeline/.env to git.

# ─── Alpaca Markets ───────────────────────────────────────────────────────────
# Primary paper trading account (organic autonomous trading)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# Secondary paper trading account (optional — for demo or account separation)
ALPACA_HACKATHON_KEY=your_second_alpaca_api_key_here
ALPACA_HACKATHON_SECRET=your_second_alpaca_secret_key_here

# ─── News Feed APIs ───────────────────────────────────────────────────────────
# Finnhub — free tier available at https://finnhub.io
FINNHUB_TOKEN=your_finnhub_token_here

# Marketaux — free tier available at https://marketaux.com
MARKETAUX_TOKEN=your_marketaux_token_here

# ─── Inference Endpoints ──────────────────────────────────────────────────────
# All endpoints must be OpenAI-compatible (/v1/chat/completions).
# Use any inference engine you prefer — llama.cpp, Ollama, vLLM, LM Studio,
# Jan, OpenRouter, or a hosted provider. Self-hosted models recommended
# for privacy and cost, but any OpenAI-compatible API will work.

# Reasoning model — used for daily sector predictions (DeepSeek R1 recommended)
# Needs strong reasoning capability, 70B+ preferred
SPARK_LLAMA_HOST=http://localhost:8083

# Scoring model — used for news sentiment scoring (Qwen3-30B recommended)
# Needs fast inference, runs every 5 minutes
LLAMA_SCORE_URL=http://localhost:8080/v1/chat/completions
LLAMA_SCORE_MODEL=your-scoring-model-name

# Embedding model — used for Qdrant vector storage (BGE-M3 recommended)
LLAMA_EMBED_URL=http://localhost:8081/v1/embeddings
LLAMA_EMBED_MODEL=your-embedding-model-name

# ─── Vector Database ──────────────────────────────────────────────────────────
# Qdrant — https://qdrant.tech (Docker install recommended)
# docker run -p 6333:6333 qdrant/qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=trading_signals

# ─── Reasoning Model Alias ────────────────────────────────────────────────────
# Informational only — passed to the inference endpoint as model name
REASONING_MODEL=your-reasoning-model-name

# ─── Storage Paths ────────────────────────────────────────────────────────────
# Where scored signal JSONL files and logs are stored
TIMESERIES_DIR=/path/to/your/timeseries/signals

# Where raw RSS feed archives are stored (optional)
RAW_FEEDS_DIR=/path/to/your/raw-feeds

# Maximum age of articles to ingest (hours)
MAX_ARTICLE_AGE_HOURS=24

